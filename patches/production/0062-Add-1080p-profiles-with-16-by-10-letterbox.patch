+++ b/tests/test_wfd_hd_profile.py
@@ -0,0 +1,51 @@
+import unittest
+
+from wfd.config import WFDMediaConfig, WFDVideoFormat
+from wfd.constants import WFD_CEA_1080P30, WFD_CEA_1080P60, WFD_CEA_720P30
+from wfd.encoding import _gsr_fitted_size
+from wfd.modes import _choose_cea_mode, _h264_level_for_mode, _selected_video_format
+
+
+def _sink(cea_mask: int, level: str = "1f") -> WFDVideoFormat:
+    return WFDVideoFormat(
+        native="00", preferred="00", profile="01", level=level,
+        cea_mask=cea_mask, vesa_mask=0, hh_mask=0,
+    )
+
+
+class HDProfileTest(unittest.TestCase):
+    def test_16_by_10_panel_fits_1728x1080_with_96px_side_bars(self):
+        fitted = _gsr_fitted_size(2880, 1800, 1920, 1080)
+        self.assertEqual(fitted, (1728, 1080))
+        self.assertEqual((1920 - fitted[0]) // 2, 96)
+        self.assertEqual((1080 - fitted[1]) // 2, 0)
+
+    def test_h264_level_matches_the_1080p_mode(self):
+        self.assertEqual(_h264_level_for_mode(WFDMediaConfig(monitor=None, output_resolution="1280x720", fps=60)), "3.2")
+        self.assertEqual(_h264_level_for_mode(WFDMediaConfig(monitor=None, output_resolution="1920x1080", fps=60)), "4.2")
+        self.assertEqual(_h264_level_for_mode(WFDMediaConfig(monitor=None, output_resolution="1920x1080", fps=30)), "4.0")
+
+    def test_1080p60_falls_back_when_the_sink_accepts_only_30(self):
+        config = WFDMediaConfig(monitor=None, output_resolution="1920x1080", fps=60)
+        mode = _choose_cea_mode(config, _sink(WFD_CEA_1080P30 | WFD_CEA_720P30))
+        self.assertEqual(mode.name, "1920x1080p30")
+        selected = _selected_video_format(config, _sink(WFD_CEA_1080P30 | WFD_CEA_720P30))
+        self.assertIn(f"{WFD_CEA_1080P30:08x}", selected)
+        self.assertIn(" 04 ", selected)
+
+    def test_1080p60_is_kept_when_the_sink_under_advertises(self):
+        config = WFDMediaConfig(monitor=None, output_resolution="1920x1080", fps=60)
+        mode = _choose_cea_mode(config, _sink(WFD_CEA_720P30))
+        self.assertEqual(mode.name, "1920x1080p60")
+        selected = _selected_video_format(config, _sink(WFD_CEA_1080P60 | WFD_CEA_1080P30))
+        self.assertIn(f"{WFD_CEA_1080P60:08x}", selected)
+        self.assertIn(" 10 ", selected)
+
+    def test_explicit_1080p30_negotiates_that_mode(self):
+        config = WFDMediaConfig(monitor=None, output_resolution="1920x1080", fps=30)
+        mode = _choose_cea_mode(config, _sink(WFD_CEA_1080P60 | WFD_CEA_1080P30))
+        self.assertEqual(mode.name, "1920x1080p30")
+
+
+if __name__ == "__main__":
+    unittest.main()
