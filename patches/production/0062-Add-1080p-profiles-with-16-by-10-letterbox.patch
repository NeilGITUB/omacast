+def _gsr_fitted_size(src_w: int, src_h: int, out_w: int, out_h: int) -> tuple[int, int]:
+    """Match gpu-screen-recorder's truncating aspect-fit for ``-s``.
+
+    ``-s WxH`` is a limit, not a canvas. A 2880x1800 panel limited to
+    1920x1080 becomes 1728x1080; the caller pads back to the WFD frame.
+    """
+    if src_w <= 0 or src_h <= 0 or out_w <= 0 or out_h <= 0:
+        return max(out_w, 0), max(out_h, 0)
+    width = out_w
+    height = int(width * (src_h / src_w))
+    if height > out_h:
+        height = out_h
+        width = int(height * (src_w / src_h)) if src_h else 0
+    if width < 1:
+        width = 1
+    if height < 1:
+        height = 1
+    return width, height
+
+
